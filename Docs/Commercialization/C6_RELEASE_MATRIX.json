        "Scripts/check-telemetry-contract.sh",
        "Scripts/check-telemetry-worker-contract.sh",
        "Scripts/check-telemetry-metrics-contract.sh"
      ],
      "nonAutomatedBoundary": "Development synthetic evidence remains non-customer and non-G1; C6-02/C12 own final-binary and App Store Connect verification."
    },
    {
      "id": "offline-local-pro",
      "title": "Verified local Pro remains independent of optional app-owned network failure",
      "requirements": [
        "REQ-ENTITLEMENT-001",
        "REQ-R1-NET-001",
        "REQ-R1-TELEMETRY-001"
      ],
      "swiftTests": [
        {
          "source": "MindBudgetTests/CommercializationEntitlementTests.swift",
          "type": "CommercializationEntitlementTests",
          "requiredMethods": [
            "optionalNetworkFailuresCannotChangeTheInjectedLocalProSnapshot"
          ]
        }
      ],
      "staticChecks": [
        "Scripts/check-feature-access-boundary.sh",
        "Scripts/check-network-egress.sh"
      ],
      "nonAutomatedBoundary": "This proves authority separation with deterministic failures; C6-02 owns airplane-mode observation on the signed release candidate."
    }
  ]
