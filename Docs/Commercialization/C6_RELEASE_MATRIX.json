        {
          "source": "MindBudgetTests/ReceiptOCRPrivacyTests.swift",
          "type": "ReceiptOCRPrivacyTests",
          "requiredMethods": [
            "filterRemovesCardValuesLastFourAndAuthorizationCodes",
            "pipelineFailsClosedForCountLineAndDocumentCaps"
          ]
        },
        {
          "source": "MindBudgetTests/ReceiptStructuredExtractionTests.swift",
          "type": "ReceiptStructuredExtractionTests",
          "requiredMethods": [
            "currencyExponentMatrixAcceptsJpyAndKwd",
            "modelCannotReplaceADeterministicRejection"
          ]
        },
        {
          "source": "MindBudgetTests/ReceiptImportIntegrationTests.swift",
          "type": "ReceiptImportIntegrationTests",
          "requiredMethods": [
            "recognizedFieldsRemainEphemeralUntilTheExistingSaveAction",
            "fixedReceiptMatrixCoversAtLeastSixtyExactReceiptsAndNonReceipts"
          ]
        }
      ],
      "staticChecks": [
        "Scripts/check-commercialization-docs.sh",
        "Scripts/check-release-readiness.sh"
      ],
      "nonAutomatedBoundary": "C6-02 owns final-binary camera/photo-picker, privacy disclosure, accessibility, and signed-device memory inspection."
    },
    {
      "id": "telemetry-deletion-ttl-and-local-delete",
      "title": "Optional telemetry deletion, retention, idempotency, and local financial Delete All independence",
      "requirements": [
        "REQ-R1-TELEMETRY-001"
      ],
      "swiftTests": [
        {
          "source": "MindBudgetTests/TelemetryClientTests.swift",
          "type": "TelemetryClientTests",
