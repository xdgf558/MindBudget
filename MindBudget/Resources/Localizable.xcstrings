    "ledger.empty.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No ledger entries yet"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"还没有流水"}}}},
    "ledger.empty.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Record your first expense or income when you are ready."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"准备好时，记下第一笔支出或收入。"}}}},
