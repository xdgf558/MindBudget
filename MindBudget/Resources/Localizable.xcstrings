    "settings.releaseNotes.0_9_0.foundation": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Introduced local-first budgeting, manual expense tracking, insights, wishlist cooling-off, and deterministic Ask." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "推出本地优先的预算、手动记账、洞察、愿望冷静期与确定性问答功能。" } }
      }
    },
    "settings.releaseNotes.0_9_0.privacy": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Added explicit CSV export, staged data deletion, privacy controls, and local-only reminder history." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "加入明确的 CSV 导出、分阶段数据删除、隐私控制与仅存本机的提醒历史。" } }
      }
    },
    "settings.releaseNotes.0_9_0.system": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Added optional Siri, Shortcuts, Spotlight, accessibility, and TestFlight readiness foundations." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "加入可选的 Siri、快捷指令、Spotlight、无障碍与 TestFlight 准备基础。" } }
      }
    },
    "settings.releaseNotes.history": {
      "localizations": {
