    "entry.type.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose whether this is an expense or income."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择这笔流水是支出还是收入。"}}}},
