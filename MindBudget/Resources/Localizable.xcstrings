    "settings.notifications.enabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cooling-off notifications"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期到期通知"}}}},
    "settings.notifications.status.notDetermined": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Permission has not been requested"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未请求通知权限"}}}},
    "settings.notifications.status.denied": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications are blocked in System Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统设置已关闭通知权限"}}}},
    "settings.notifications.status.authorized": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications are allowed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知权限已开启"}}}},
    "settings.notifications.status.provisional": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications are delivered quietly"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知将安静送达"}}}},
    "settings.notifications.status.ephemeral": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications are temporarily allowed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知权限暂时可用"}}}},
    "settings.notifications.openSystemSettings": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open System Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开系统设置"}}}},
    "settings.notifications.quietHours": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Quiet hours"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"静默时段"}}}},
    "settings.notifications.quietStart": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始时间"}}}},
    "settings.notifications.quietEnd": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ends"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结束时间"}}}},
    "settings.notifications.error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notification changes could not be completed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知设置未能完成更新"}}}},
    "settings.notifications.invalidStoredData": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Some cooling-off records could not be read. Other valid reminders were still updated."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分冷静期记录无法读取，其他有效提醒仍已更新。"}}}},
    "settings.notifications.invalidStoredData.count": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unreadable cooling-off records found: %d. Other valid reminders were still updated."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发现 %d 条无法读取的冷静期记录，其他有效提醒仍已更新。"}}}},
    "settings.notifications.repair.action": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review and remove unreadable records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看并移除无法读取的记录"}}}},
    "settings.notifications.repair.confirm.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove unreadable cooling-off records?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除无法读取的冷静期记录？"}}}},
    "settings.notifications.repair.confirm.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Identified records: %d. Each record is checked again and removed only if it is still unreadable. Expenses, wishlist items, and readable cooling-off history stay unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已识别 %d 条记录。每条记录都会再次检查，仅在仍无法读取时移除。消费、心愿项以及可读取的冷静期历史不会改变。"}}}},
    "settings.notifications.repair.confirm.action": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove unreadable records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除无法读取的记录"}}}},
    "settings.notifications.repair.progress": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking and removing unreadable records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查并移除无法读取的记录"}}}},
    "settings.notifications.repair.completed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unreadable cooling-off records removed: %d."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已移除 %d 条无法读取的冷静期记录。"}}}},
    "settings.notifications.repair.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unreadable records could not be removed. Nothing else was deleted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取的记录未能移除，其他内容未被删除。"}}}},
    "settings.notifications.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lock-screen notifications show the wishlist item name, but never its amount or notes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"锁屏通知会显示愿望名称，但不会显示金额或备注。"}}}},
    "wishlist.cooling.notification": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notify me when it is ready to review"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"到期时通知我回看"}}}},
    "wishlist.cooling.notificationPrivacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The notification shows this item name, but not its price or notes. Quiet hours may defer delivery."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知会显示愿望名称，不显示价格或备注；静默时段内会顺延送达。"}}}},
    "wishlist.cooling.error.notificationsDenied": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The cooling-off period started, but notifications are blocked. You can enable them in System Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期已经开始，但系统通知权限未开启；你可以前往系统设置开启。"}}}},
    "wishlist.cooling.error.notificationScheduling": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The cooling-off period started, but its notification could not be scheduled. Your local countdown is still available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期已经开始，但通知未能安排；本地倒计时仍可正常使用。"}}}},
    "export.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出 CSV"}}}},
    "export.localOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The file is prepared on this device and shared only where you choose."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文件只在本机生成，并仅分享至你选择的位置。"}}}},
    "export.includes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The CSV contains expense and income dates, exact amounts, categories, income allocations, optional source or merchant names, and raw notes. It does not contain inferred advice."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CSV 包含支出与收入日期、精确金额、分类、收入分配、可选来源或商户名和原始备注，不包含推断建议。"}}}},
    "export.spreadsheetSafety": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Text that resembles a spreadsheet formula is prefixed with an apostrophe for safety."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为避免电子表格公式执行，疑似公式的文本会加英文单引号前缀。"}}}},
    "export.file.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expense file"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"消费记录文件"}}}},
    "export.recordCount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录数"}}}},
    "export.preparing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preparing CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在生成 CSV"}}}},
    "export.share": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Share CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分享 CSV"}}}},
    "export.error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The CSV could not be prepared. Your stored data was not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CSV 未能生成，已存数据没有发生变化。"}}}},
    "privacy.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Privacy controls"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"隐私控制"}}}},
    "privacy.summary.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How data is handled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据如何处理"}}}},
    "privacy.summary.deviceOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"By default, financial records stay on this device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"默认情况下，财务记录只保留在本机"}}}},
    "privacy.summary.noTracking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No ads, tracking, or third-party analytics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无广告、追踪或第三方分析"}}}},
    "privacy.summary.noAccount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional iCloud sync is off by default"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可选的 iCloud 同步默认关闭"}}}},
    "privacy.summary.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget does not sell or share your records. System notifications are local and can be disabled at any time."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数不出售或分享你的记录；系统通知仅在本机运行，并可随时关闭。"}}}},
    "privacy.delete.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete all data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除所有数据"}}}},
    "privacy.delete.explanation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cancels MindBudget notifications, clears its system search index, removes every local record, resets app preferences, and returns to onboarding."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此操作会取消花有数通知、清空系统搜索索引、移除全部本地记录、重置应用偏好，并返回初始引导。"}}}},
    "privacy.delete.cloudBoundary": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This deletes data from this device only. Existing iCloud copies are not deleted and may be imported if sync is enabled again. Cloud-wide deletion requires a separate confirmed action that is not yet available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此操作只删除本机数据，不会删除已有的 iCloud 副本；以后再次开启同步时，这些副本可能重新导入。云端全部删除需要单独确认，目前尚未提供。"}}}},
    "privacy.delete.start": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete all local data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除全部本地数据"}}}},
    "privacy.delete.first.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete everything in MindBudget?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除花有数中的全部内容？"}}}},
    "privacy.delete.first.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cannot be undone on this device and does not delete existing iCloud copies. Export your expense and income CSV first if you need a copy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此操作在本机无法撤销，也不会删除已有的 iCloud 副本。如需保留副本，请先导出支出与收入 CSV。"}}}},
    "privacy.delete.first.continue": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Continue to final confirmation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续最终确认"}}}},
    "privacy.delete.final.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Final confirmation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最终确认"}}}},
    "privacy.delete.final.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the confirmation word shown below. Deletion starts only after you tap the final button."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入下方确认词；只有点击最终按钮后才会开始删除。"}}}},
    "privacy.delete.final.placeholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirmation word"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认词"}}}},
    "privacy.delete.final.hint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter DELETE"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入“删除”"}}}},
    "privacy.delete.confirmationWord": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"DELETE"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除"}}}},
    "privacy.delete.final.action": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Permanently delete all local data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"永久删除全部本机数据"}}}},
    "privacy.delete.progress.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion progress"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除进度"}}}},
    "privacy.delete.failure.incomplete": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion is incomplete and has not been reported as successful. You can retry the full sequence."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除尚未完整完成，应用不会显示成功；你可以重试完整流程。"}}}},
    "privacy.delete.stage.cancellingNotifications": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancelling notifications"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在取消通知"}}}},
    "privacy.delete.stage.clearingSearchIndex": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clearing the system search index"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在清空系统搜索索引"}}}},
    "privacy.delete.stage.deletingLocalData": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deleting local records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在删除本地记录"}}}},
    "privacy.delete.stage.resettingPreferences": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Resetting app preferences"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在重置应用偏好"}}}},
    "privacy.delete.failure.cancellingNotifications": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications could not be fully cancelled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能完整取消通知"}}}},
