    "ask.purchase.category": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Category"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分类"}}}},
    "ask.purchase.amountError": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid amount for this currency."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入该币种支持的有效金额。"}}}},
    "ask.purchase.clarification": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Amount and category are used only for this answer and are not saved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额和分类只用于本次回答，不会保存。"}}}},
    "ask.submit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Get answer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"获取回答"}}}},
