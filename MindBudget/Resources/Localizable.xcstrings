    "brand.productName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MindBudget"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花有数"
          }
        }
      }
    },
    "brand.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle budgeting and spending review tool"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温和的预算与消费复盘工具"
          }
        }
      }
    },
    "bootstrap.status.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MindBudget is ready"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花有数已就绪"
          }
        }
      }
    },
