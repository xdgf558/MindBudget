    "insight.highSinglePurchase.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A %@ expense was recorded in this cycle."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期记录了一笔 %@ 的支出。"}}}},
    "insight.categoryBudgetRisk.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Category budget progress"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分类预算进度"}}}},
    "insight.categoryBudgetRisk.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ has reached %d%% of its current plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 已达到当前预算的 %d%%。"}}}},
    "insight.lateNightSpending.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Late-hour pattern"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"较晚时段的记录"}}}},
    "insight.lateNightSpending.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"There were %d qualifying late-hour expenses in the recent window."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最近时间窗内有 %d 笔符合条件的较晚时段支出。"}}}},
    "insight.repeatedStressSpending.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stress-related pattern"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"与压力相关的记录"}}}},
