    "ask.answer.enhanced": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device enhanced"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机增强"}}}},
    "ask.answer.template": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local template"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地模板"}}}},
    "ask.answer.fallback.validation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Safety fallback"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安全回退"}}}},
    "ask.answer.fallback.validation.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The on-device wording did not pass local safety checks, so the complete local answer is shown."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机生成的措辞未通过本地安全校验，已显示完整的本地回答。"}}}},
    "ask.answer.fallback.error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local fallback"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地回退"}}}},
    "ask.answer.fallback.error.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The on-device wording could not be completed, so the complete local answer is shown."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机措辞未能完成，已显示完整的本地回答。"}}}},
    "ask.answer.fallback.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enhancement unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"增强暂不可用"}}}},
    "ask.answer.fallback.unavailable.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device enhancement is off or unavailable, so the complete local answer is shown."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机增强已关闭或暂不可用，已显示完整的本地回答。"}}}},
    "ask.answer.fallback.timeout": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enhancement timed out"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"增强响应超时"}}}},
    "ask.answer.fallback.timeout.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device enhancement took too long, so the complete local answer is shown."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机增强响应超时，已显示完整的本地回答。"}}}},
    "ask.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your question is classified on this device and is never saved. AI enhancement receives only allow-listed aggregate facts, never notes or transaction rows."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"问题只在本机分类且不会保存。AI 增强只接收明确允许的聚合事实，不接收备注或逐笔记录。"}}}},
    "ask.answer.canIAfford.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Budget check"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预算检查"}}}},
    "ask.answer.canIAfford.clarify": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add an amount and category so I can calculate the impact without guessing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请补充金额和分类，我会据此计算影响，不猜测数值。"}}}},
    "ask.answer.canIAfford.within": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is within the currently available %@. You can still choose to pause or continue."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 在当前可用的 %@ 之内。你仍可以选择暂缓或继续。"}}}},
    "ask.answer.canIAfford.outside": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is above the currently available %@. A pause or budget adjustment may help."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 高于当前可用的 %@。可以先暂缓，或调整预算。"}}}},
    "ask.answer.remainingBudget.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Budget remaining"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"剩余预算"}}}},
    "ask.answer.remainingBudget.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You have %@ in flexible budget left. The calculated daily amount is %@ for %d remaining days."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"灵活预算还剩 %@。余下 %3$d 天，计算得出的每日金额是 %2$@。"}}}},
    "ask.answer.remainingBudget.breakdown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your total budget has %1$@ remaining. After reserving %2$@ for pending fixed expenses and %3$@ for the remaining savings goal, you can use %4$@ now. With %6$d days left, the calculated daily reference is %5$@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期总预算还剩 %1$@。为尚未发生的固定支出预留 %2$@、为剩余储蓄目标预留 %3$@ 后，目前可以使用 %4$@。余下 %6$d 天，每日参考金额为 %5$@。"}}}},
    "ask.answer.remainingBudget.breakdown.over": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your total budget has %1$@ remaining. After reserving %2$@ for pending fixed expenses and %3$@ for the remaining savings goal, the currently available amount is over by %4$@. With %6$d days left, the calculated daily reference is %5$@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期总预算还剩 %1$@。为尚未发生的固定支出预留 %2$@、为剩余储蓄目标预留 %3$@ 后，当前可用额度已超出 %4$@。余下 %6$d 天，每日参考金额为 %5$@。"}}}},
    "ask.answer.stressPattern.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Self-tagged pattern"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自选标签模式"}}}},
    "ask.answer.stress.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cycle has %d records you tagged as stressed, anxious, or stress relief."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期有 %d 笔记录被你标记为压力、焦虑或缓解压力。"}}}},
    "ask.answer.stress.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cycle has no records with those self-selected stress tags."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期没有使用这些自选压力标签的记录。"}}}},
    "ask.answer.impulsePattern.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Impulse tags"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冲动标签"}}}},
    "ask.answer.impulse.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cycle has %d records you tagged as impulse-related."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期有 %d 笔记录被你标记为与冲动有关。"}}}},
    "ask.answer.impulse.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cycle has no records with a self-selected impulse tag."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期没有使用自选冲动标签的记录。"}}}},
    "ask.answer.categoryChange.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Category change"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分类变化"}}}},
    "ask.answer.categoryChange.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ increased the most: %@ this cycle compared with %@ in the previous month window."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 增加最多：本周期 %@，上一个月度窗口 %@。"}}}},
    "ask.answer.categoryChange.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"There is not enough comparable spending to identify an increased category."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前没有足够的可比消费记录来识别增加的分类。"}}}},
    "ask.answer.alternative.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A few alternatives"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"几个替代选择"}}}},
    "ask.answer.alternative.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You could save it to the wishlist, start a cooling-off period, or revisit it next cycle."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以先加入愿望清单、开始冷静期，或留到下个周期再看。"}}}},
    "ask.answer.wishlistStatus.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wishlist status"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"愿望清单状态"}}}},
    "ask.answer.wishlistStatus.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%d items are cooling off or ready to review, and %d remain active."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 项正在冷静期或待回看，%d 项仍为活动状态。"}}}},
    "ask.answer.unknown.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What I can answer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我能回答的内容"}}}},
    "ask.answer.unknown.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask about remaining budget, affordability, category changes, self-selected stress or impulse tags, alternatives, or wishlist status."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你可以问剩余预算、是否负担得起、分类变化、自选的压力或冲动标签、替代选择或愿望清单状态。"}}}},
    "ask.answer.outOfScope.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Outside this tool"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"超出工具范围"}}}},
    "ask.answer.outOfScope.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget cannot provide investment, tax, loan, legal, diagnostic, or mental-health advice. I can help summarize your recorded budget facts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数不提供投资、税务、贷款、法律、诊断或心理健康建议。我可以帮你概括已记录的预算事实。"}}}},
    "ask.action.reviewRecentSpending": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review recent spending"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"回看近期消费"}}}},
    "ask.action.adjustBudget": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review budget settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查预算设置"}}}},
