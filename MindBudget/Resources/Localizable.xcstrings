        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“问花有数”现会使用当前界面语言显示回答和操作名称。"
          }
        }
      }
    },
    "settings.releaseNotes.budgetEditing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored editing for the current period's income, spending budget, fixed expenses, savings goal, and future cycle start day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复当前周期的月收入、支出预算、固定支出、储蓄目标与后续周期起始日修改功能。"
          }
        }
      }
    },
    "settings.releaseNotes.chineseBrand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simplified Chinese now consistently uses the product name 花有数."
          }
        },
