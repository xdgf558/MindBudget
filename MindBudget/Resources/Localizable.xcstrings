    "settings.reminders.dailyLimit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Daily interruptions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每日打断上限"}}}},
    "settings.reminders.localOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rules, frequency control, and reminder history stay on this device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"规则、频控和提醒历史都只保留在本机。"}}}},
    "notification.cooling.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"About %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关于 %@"}}}},
    "notification.cooling.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The %d-hour cooling-off period is over. Would you like to review it?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 小时冷静期已结束，现在要回看一下吗？"}}}},
