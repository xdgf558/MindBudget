    "settings.notifications.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lock-screen notifications show the wishlist item name, but never its amount or notes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"锁屏通知会显示愿望名称，但不会显示金额或备注。"}}}},
    "wishlist.cooling.notification": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notify me when it is ready to review"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"到期时通知我回看"}}}},
    "wishlist.cooling.notificationPrivacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The notification shows this item name, but not its price or notes. Quiet hours may defer delivery."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知会显示愿望名称，不显示价格或备注；静默时段内会顺延送达。"}}}},
    "wishlist.cooling.error.notificationsDenied": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The cooling-off period started, but notifications are blocked. You can enable them in System Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期已经开始，但系统通知权限未开启；你可以前往系统设置开启。"}}}},
    "wishlist.cooling.error.notificationScheduling": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The cooling-off period started, but its notification could not be scheduled. Your local countdown is still available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期已经开始，但通知未能安排；本地倒计时仍可正常使用。"}}}},
    "export.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出 CSV"}}}},
    "export.localOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The file is prepared on this device and shared only where you choose."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文件只在本机生成，并仅分享至你选择的位置。"}}}},
    "export.includes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The CSV contains expense dates, exact amounts, categories, optional merchant names, and raw notes. It does not contain inferred advice."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CSV 包含消费日期、精确金额、分类、可选商户名和原始备注，不包含推断建议。"}}}},
    "export.spreadsheetSafety": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Text that resembles a spreadsheet formula is prefixed with an apostrophe for safety."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为避免电子表格公式执行，疑似公式的文本会加英文单引号前缀。"}}}},
    "export.file.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expense file"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"消费记录文件"}}}},
    "export.recordCount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录数"}}}},
    "export.preparing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preparing CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在生成 CSV"}}}},
    "export.share": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Share CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分享 CSV"}}}},
    "export.error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The CSV could not be prepared. Your stored data was not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CSV 未能生成，已存数据没有发生变化。"}}}},
    "privacy.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Privacy controls"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"隐私控制"}}}},
    "privacy.summary.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How data is handled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据如何处理"}}}},
    "privacy.summary.deviceOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Financial records stay on this device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"财务记录只保留在本机"}}}},
    "privacy.summary.noTracking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No ads, tracking, or third-party analytics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无广告、追踪或第三方分析"}}}},
    "privacy.summary.noAccount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No account or cloud sync in V1"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"V1 无账号或云同步"}}}},
    "privacy.summary.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget does not sell or share your records. System notifications are local and can be disabled at any time."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MindBudget 不出售或分享你的记录；系统通知仅在本机运行，并可随时关闭。"}}}},
    "privacy.delete.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete all data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除所有数据"}}}},
    "privacy.delete.explanation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cancels MindBudget notifications, clears its system search index, removes every local record, resets app preferences, and returns to onboarding."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此操作会取消 MindBudget 通知、清空系统搜索索引、移除全部本地记录、重置应用偏好，并返回初始引导。"}}}},
    "privacy.delete.start": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete all local data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除全部本地数据"}}}},
    "privacy.delete.first.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete everything in MindBudget?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除 MindBudget 中的全部内容？"}}}},
    "privacy.delete.first.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cannot be undone. Export your expense CSV first if you need a copy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此操作无法撤销。如需保留副本，请先导出消费 CSV。"}}}},
    "privacy.delete.first.continue": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Continue to final confirmation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续最终确认"}}}},
    "privacy.delete.final.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Final confirmation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最终确认"}}}},
    "privacy.delete.final.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the confirmation word shown below. Deletion starts only after you tap the final button."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入下方确认词；只有点击最终按钮后才会开始删除。"}}}},
    "privacy.delete.final.placeholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirmation word"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认词"}}}},
    "privacy.delete.final.hint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter DELETE"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入“删除”"}}}},
    "privacy.delete.confirmationWord": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"DELETE"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除"}}}},
    "privacy.delete.final.action": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Permanently delete all data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"永久删除全部数据"}}}},
    "privacy.delete.progress.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion progress"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除进度"}}}},
    "privacy.delete.failure.incomplete": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion is incomplete and has not been reported as successful. You can retry the full sequence."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除尚未完整完成，应用不会显示成功；你可以重试完整流程。"}}}},
    "privacy.delete.stage.cancellingNotifications": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancelling notifications"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在取消通知"}}}},
    "privacy.delete.stage.clearingSearchIndex": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clearing the system search index"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在清空系统搜索索引"}}}},
    "privacy.delete.stage.deletingLocalData": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deleting local records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在删除本地记录"}}}},
    "privacy.delete.stage.resettingPreferences": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Resetting app preferences"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在重置应用偏好"}}}},
    "privacy.delete.failure.cancellingNotifications": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications could not be fully cancelled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能完整取消通知"}}}},
    "privacy.delete.failure.clearingSearchIndex": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The system search index could not be fully cleared"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能完整清空系统搜索索引"}}}},
    "privacy.delete.failure.deletingLocalData": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local records could not be fully deleted"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能完整删除本地记录"}}}},
    "privacy.delete.failure.resettingPreferences": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App preferences could not be fully reset"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能完整重置应用偏好"}}}},
