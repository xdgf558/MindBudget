    "ask.suggestion.remaining": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How much is left?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这个周期还剩多少？"}}}},
    "ask.suggestion.stress": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Any stress pattern?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"有压力消费的模式吗？"}}}},
