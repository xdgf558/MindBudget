    "settings.budget.basics.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accounting currency stays locked. A new cycle start day applies after the current period and may require confirmation for a shorter transition period."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记账币种保持锁定。新的周期起始日会在当前周期结束后生效；如产生较短的过渡周期，花有数会请你另行确认。"
          }
        }
      }
    },
    "settings.budget.currentPeriod": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current period"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前周期"
          }
        }
      }
    },
    "settings.budget.flexiblePreview": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Disposable budget this period" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "本期可支配预算" } }
      }
    },
    "settings.budget.legacyFixedForecast": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This current legacy period keeps its previous expected-expense funding base and any fixed-expense reservation so the upgrade does not change its disposable budget. Next period switches to income minus savings, with fixed expenses counted only when recorded." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前旧版周期会继续使用原有的预计支出计算基准及固定支出预留，避免升级后可支配预算发生变化。下个周期将改为按本月收入减储蓄目标计算，固定支出仅在实际记账后计入。" } }
      }
    },
    "settings.budget.allocation.zeroBudget": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "No funding is currently available under this period's calculation, so the disposable budget is zero." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "按本周期的计算方式，目前没有可用于支出的金额，因此本期可支配预算为 0。" } }
      }
    },
    "settings.budget.allocation.fullyAllocated": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Current savings and compatibility reservations use all funding available under this period's calculation, so the disposable budget is zero." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前储蓄与兼容预留已用完按本周期计算方式可用的金额，因此本期可支配预算为 0。" } }
      }
    },
    "settings.budget.allocation.overcommitted": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Current savings and compatibility reservations exceed the funding available under this period's calculation. You can still save, but the disposable budget will stay at zero." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "当前储蓄与兼容预留超过按本周期计算方式可用的金额。你仍可保存，但本期可支配预算会显示为 0。" } }
      }
    },
    "settings.budget.error.notCurrent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current budget changed while this page was open. Reload it and try again."
          }
        },
        "zh-Hans": {
