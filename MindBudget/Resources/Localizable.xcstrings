    "entity.insight.imageRelatedIncrease": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Image-related change"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"形象相关支出变化"}}}},
    "entity.insight.impulseCluster": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Several quick decisions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"几次快速消费决定"}}}},
