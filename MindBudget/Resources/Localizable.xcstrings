      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm Budgets"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认预算"
          }
        }
      }
    },
    "budget.currency": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounting currency"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记账币种"
          }
        }
      }
    },
    "budget.currency.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accounting currency cannot be changed after your first budget is saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首个预算保存后，记账币种将不能更改。"
          }
        }
      }
    },
    "budget.cycleStartDay": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycle starts on day"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预算周期起始日"
          }
        }
      }
    },
    "budget.error.income": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid monthly income."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的月收入。"
          }
        }
      }
    },
    "budget.error.reserved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed expenses and the savings goal cannot exceed the spending budget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定支出与储蓄目标之和不能超过支出预算。"
          }
        }
      }
    },
    "budget.error.saving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid savings goal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的储蓄目标。"
          }
        }
      }
    },
    "budget.error.total": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid spending budget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的支出预算。"
          }
        }
      }
    },
    "budget.firstRegular.amounts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following regular-period amounts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随后常规周期金额"
          }
        }
      }
    },
    "budget.firstRegular.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MindBudget will not copy a short-period amount into a full period without your confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经你确认，花有数不会把短周期金额沿用到完整周期。"
          }
        }
      }
    },
    "budget.firstRegular.recovery.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the regular-period amounts. MindBudget leaves them blank instead of guessing from a short period."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入常规周期金额。花有数不会根据短周期金额进行猜测。"
          }
        }
      }
    },
    "budget.firstRegular.period": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following regular period"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随后的常规周期"
          }
        }
      }
    },
    "budget.firstRegular.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the next regular budget"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认下一个常规周期预算"
          }
        }
      }
