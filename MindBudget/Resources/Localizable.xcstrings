    "ask.action.startCoolingOff24h": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start a cooling-off period"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始冷静期"}}}},
    "ask.action.waitUntilNextCycle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Revisit next cycle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下个周期再看"}}}},
