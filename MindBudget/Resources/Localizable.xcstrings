    "settings.ai.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enhancement runs with Apple's on-device model and receives only allow-listed aggregate facts. Questions, notes, and transaction rows are never sent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"增强使用 Apple 本机模型，仅接收明确允许的聚合事实。问题原文、备注和逐笔记录绝不会发送。"}}}},
    "settings.ai.status.available": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Intelligence enhancement is available"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple Intelligence 增强可用"}}}},
    "settings.ai.status.userDisabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enhancement is off"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"增强已关闭"}}}},
    "settings.ai.status.osTooOld": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Requires iOS 26 or later"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要 iOS 26 或更高版本"}}}},
    "settings.ai.status.deviceNotEligible": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Intelligence is not supported on this device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备不支持 Apple Intelligence"}}}},
    "settings.ai.status.appleIntelligenceOff": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Intelligence is off in System Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统设置中的 Apple Intelligence 已关闭"}}}},
    "settings.ai.status.modelNotReady": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The on-device model is not ready yet"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机模型尚未就绪"}}}},
    "settings.ai.status.languageNotSupported": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected app language is not supported by Apple Intelligence. Choose Follow System or another supported language."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前选择的 App 语言暂不支持 Apple Intelligence，可切换为“跟随系统”或其他受支持语言。"}}}},
    "settings.ai.status.buildUnsupported": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This build does not include on-device enhancement"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前版本未包含本机增强"}}}},
    "settings.ai.status.unknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enhancement is currently unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"增强当前不可用"}}}},
    "insights.summary.narrative.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cycle snapshot"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"周期概览"}}}},
    "insights.summary.narrative.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recorded spending uses %d%% of this cycle's budget. %@ is the leading category by recorded amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已记录消费占本周期预算的 %d%%。%@ 是已记录金额最高的分类。"}}}},
    "insights.summary.narrative.body.lessThanOnePercent": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recorded spending uses less than 1%% of this cycle's budget. %@ is the leading category by recorded amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已记录消费占本周期预算不足 1%%。%@ 是已记录金额最高的分类。"}}}},
    "insights.summary.narrative.body.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recorded spending is available, but this cycle has no budget baseline for a percentage. %@ is the leading category by recorded amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已记录本周期消费，但当前没有可用于计算占比的周期预算基线。%@ 是已记录金额最高的分类。"}}}},
    "insights.summary.noCategory": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No category"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂无分类"}}}},
    "settings.integrations.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Siri and Search"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Siri 与搜索"}}}},
    "settings.integrations.siri": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use with Siri and Shortcuts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"与 Siri 和快捷指令配合使用"}}}},
    "settings.integrations.siri.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"When you explicitly ask Siri to check budget impact, the authenticated result may speak the exact calculated flexible budget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当你主动请 Siri 查看预算影响时，通过认证的结果可能会播报精确的计算后灵活预算。"}}}},
    "settings.integrations.spotlight": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Show redacted items in Search"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在搜索中显示脱敏项目"}}}},
    "settings.integrations.merchants": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Include eligible merchant names"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"包含符合条件的商户名"}}}},
    "settings.integrations.merchants.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A merchant appears only when at least one matching expense also allows merchant indexing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅当至少一笔匹配消费也允许商户索引时，该商户才会显示。"}}}},
    "settings.integrations.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Both controls are off by default. Search excludes exact amounts and notes. Merchant names remain excluded unless you enable both levels of consent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"两项功能默认均关闭。搜索不包含精确金额和备注；只有你开启两层授权时才会包含商户名。"}}}},
    "settings.integrations.spotlight.error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search items could not be updated. Your local records are unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索项目未能更新，本地记录不受影响。"}}}},
    "settings.integrations.spotlight.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search indexing is unavailable on this device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备当前无法使用搜索索引。"}}}},
    "intent.error.siriDisabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Siri integration is off in MindBudget settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数设置中的 Siri 集成已关闭。"}}}},
    "intent.error.invalidAmount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a positive amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入正数金额。"}}}},
    "intent.error.amountOutOfRange": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a smaller amount within MindBudget's supported range."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入花有数支持范围内的金额。"}}}},
    "intent.error.unsupportedPrecision": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This amount has more decimal places than the selected currency supports."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该金额的小数位超过了所选币种支持的位数。"}}}},
    "intent.error.unsupportedCurrency": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"That currency is not supported by MindBudget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数暂不支持该币种。"}}}},
    "intent.error.temporary": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget cannot complete this right now. Try again in a moment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数暂时无法完成此操作，请稍后再试。"}}}},
    "intent.error.invalidText": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add a name before continuing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先添加名称。"}}}},
    "intent.error.currencyNotConfigured": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Finish budget setup in MindBudget before using this action."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先在花有数中完成预算设置。"}}}},
    "intent.error.currencyMismatch": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The requested currency does not match the accounting currency. Confirm the currency in MindBudget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请求的币种与记账币种不一致。请在花有数中确认币种。"}}}},
    "intent.error.budgetUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A current confirmed budget is needed for this calculation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这项计算需要当前已确认的预算。"}}}},
    "intent.error.itemUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"That item is no longer available in the wishlist."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该项目已不在愿望清单中。"}}}},
    "intent.error.data": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget could not read the required local data."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数未能读取所需的本地数据。"}}}},
    "intent.record.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Record Expense"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录消费"}}}},
    "intent.record.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Records one expense in the configured accounting currency."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用已设置的记账币种记录一笔消费。"}}}},
    "intent.record.summary ${amount} ${category}": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Record ${amount} in ${category}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 ${category} 记录 ${amount}"}}}},
    "intent.record.success": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The expense was recorded."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"消费已记录。"}}}},
    "intent.record.duplicate": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"That expense was already recorded in the last five seconds, so no duplicate was added."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该消费在过去 5 秒内已记录，因此未重复添加。"}}}},
    "intent.wishlist.add.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add Wishlist Item"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加愿望清单项"}}}},
    "intent.wishlist.add.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Adds an item with a default 24-hour cooling-off duration."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加一项，默认冷静期时长为 24 小时。"}}}},
    "intent.wishlist.add.summary ${itemName} ${category}": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add ${itemName} in ${category}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将 ${itemName} 添加到 ${category}"}}}},
    "intent.wishlist.add.success": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The item was added with a 24-hour cooling-off default."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"项目已添加，默认冷静期为 24 小时。"}}}},
    "intent.impact.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check Budget Impact"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看预算影响"}}}},
    "intent.impact.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calculates a candidate purchase without saving its name or amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计算候选购买对预算的影响，不保存其名称或金额。"}}}},
    "intent.impact.summary ${amount} ${category}": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check ${amount} in ${category}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看 ${category} 中的 ${amount}"}}}},
    "intent.impact.within": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"After this purchase, the calculated flexible budget would be %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这笔购买后，计算得出的灵活预算为 %@。"}}}},
    "intent.impact.over": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This purchase would take the calculated budget below zero. The flexible budget after it would be %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这笔购买会使计算预算低于零，之后的灵活预算为 %@。"}}}},
    "intent.emotion.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review Emotional Spending"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"回顾情绪消费"}}}},
    "intent.emotion.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Counts recent records with user-selected emotion or reason tags."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"统计近期带有用户自选情绪或原因标签的记录。"}}}},
    "intent.emotion.result": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"There are %d matching records in the last 30 days."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"过去 30 天有 %d 笔匹配记录。"}}}},
    "intent.cooling.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start Cooling-Off Period"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始冷静期"}}}},
    "intent.cooling.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starts a local cooling-off period for a wishlist item."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为愿望清单项开始本地冷静期。"}}}},
    "intent.cooling.summary ${item} ${durationHours}": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start ${durationHours} hours for ${item}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为 ${item} 开始 ${durationHours} 小时冷静期"}}}},
    "intent.cooling.success.scheduled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The cooling-off period was started and its review notification was scheduled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期已开始，回看通知已安排。"}}}},
    "intent.cooling.success.local": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The local cooling-off period was started. No notification was scheduled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地冷静期已开始，未安排通知。"}}}},
    "intent.alternative.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Suggest an Alternative"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"建议替代选择"}}}},
    "intent.alternative.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Offers neutral next steps without saving the candidate item name."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提供中性的下一步选择，不保存候选商品名。"}}}},
    "intent.alternative.result": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You could add it to the wishlist, start a 24-hour cooling-off period, or revisit it next cycle."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以将它加入愿望清单、开始 24 小时冷静期，或下个周期再看。"}}}},
    "intent.pattern.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Find Recent Spending Pattern"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查找近期消费模式"}}}},
    "intent.pattern.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Returns the latest deterministic local insight from the last 30 days."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"返回过去 30 天最新的确定性本地洞察。"}}}},
    "intent.pattern.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No recent stored pattern is available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前没有可用的近期已存储模式。"}}}},
    "intent.pattern.result": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The latest stored pattern is: %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最新已存储模式是：%@。"}}}},
    "intent.openWishlist.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Wishlist Item"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开愿望清单项"}}}},
    "intent.openWishlist.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens a selected wishlist item in MindBudget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在花有数中打开选定的愿望清单项。"}}}},
    "intent.openWishlist.summary ${item}": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open ${item}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 ${item}"}}}},
    "intent.openDashboard.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Budget Dashboard"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开预算仪表盘"}}}},
