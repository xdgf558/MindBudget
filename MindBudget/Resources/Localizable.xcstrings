    "privacy.appLock.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App lock"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用锁"}}}},
    "privacy.appLock.toggle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Require Face ID"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用面容 ID 保护"}}}},
    "privacy.appLock.footer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget locks on launch and whenever you return from the background. Face ID is used first; the device passcode remains available as a recovery path."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数会在启动及从后台返回时上锁。解锁时优先使用面容 ID，必要时可用设备密码恢复访问。"}}}},
    "privacy.appLock.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Face ID is not set up on this iPhone. Add a face in iOS Settings before enabling the app lock."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这台 iPhone 尚未设置面容 ID。请先在系统“设置”中添加面容，再开启应用锁。"}}}},
    "privacy.appLock.authenticating": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirming identity…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在验证身份…"}}}},
    "privacy.appLock.authenticationFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Identity could not be confirmed. The app-lock setting was not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能确认身份，应用锁设置没有改变。"}}}},
    "privacy.appLock.enable.reason": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm your identity to turn on the MindBudget app lock."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请确认身份以开启花有数应用锁。"}}}},
    "privacy.appLock.disable.reason": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm your identity to turn off the MindBudget app lock."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请确认身份以关闭花有数应用锁。"}}}},
    "appLock.authentication.reason": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock MindBudget to view your local budget records."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解锁花有数以查看你的本地预算记录。"}}}},
    "appLock.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget is locked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数已上锁"}}}},
    "appLock.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirm your identity to continue."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请确认身份后继续。"}}}},
    "appLock.authenticating": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirming identity"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在验证身份"}}}},
    "appLock.unlock": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解锁"}}}},
    "appLock.error.authenticationFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget remains locked. Try again when you are ready."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数仍处于上锁状态，准备好后可再次尝试。"}}}},
