    "insight.imageRelatedIncrease.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cycle totals %@, or %d%% of the historical average."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期合计 %@，约为历史平均的 %d%%。"}}}},
    "insight.impulseCluster.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Several quick decisions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"几次快速消费决定"}}}},
    "insight.impulseCluster.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You tagged %d expenses as impulse-related in the recent window."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最近时间窗内有 %d 笔支出被你标记为冲动相关。"}}}},
    "insight.wishlistCoolingOff.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wishlist cooling-off"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"愿望清单冷静期"}}}},
    "insight.wishlistCoolingOff.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A wishlist item is ready for a calm review."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"有一个愿望可以平静地回看了。"}}}},
    "insight.coolingOffSuccess.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cooling-off helped"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期带来了帮助"}}}},
