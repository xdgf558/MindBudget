    "income.edit.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit Income"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑收入"}}}},
    "income.amount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Income amount"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入金额"}}}},
    "income.budget.independent": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This entry stays in your income history and does not change the budget you set."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这笔收入会保留在收入流水中，不会自动修改你已设定的预算。"}}}},
    "income.category": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Income category"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入分类"}}}},
    "income.source.optional": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Source (optional)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源（可选）"}}}},
    "income.source": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Source"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源"}}}},
    "income.note.optional": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Note (optional)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备注（可选）"}}}},
    "income.note": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Note"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"备注"}}}},
    "income.date": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Received on"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"到账时间"}}}},
    "income.details": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Income details"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入详情"}}}},
    "income.detail.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Income"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入"}}}},
    "income.delete.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete this income entry?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除这笔收入？"}}}},
    "income.delete.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This removes only this income record and cannot be undone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅会删除这笔收入记录，且无法撤销。"}}}},
    "income.row.prefix": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Income"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入"}}}},
    "income.category.salary": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Salary"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"工资"}}}},
    "income.category.bonus": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Bonus"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"奖金"}}}},
    "income.category.freelance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Freelance"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自由职业"}}}},
    "income.category.investment": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Investment"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"投资收益"}}}},
    "income.category.gift": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gift"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"赠予"}}}},
    "income.category.refund": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refund"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"退款"}}}},
    "income.category.other": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Other"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"其他"}}}},
    "wishlist.limit.available": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open wishlist items"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"进行中的愿望"}}}},
    "wishlist.limit.reached": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Five open items reached"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"进行中的愿望已满 5 条"}}}},
    "wishlist.error.limitReached": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You can keep up to five open wishlist items. Finish or archive one before adding another."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最多可保留 5 条进行中的愿望。请先完成、放弃或归档一条，再添加新的愿望。"}}}},
    "wishlist.error.featureNotYetAvailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cooling-off option is not available yet. The basic 24-hour period remains available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这项冷静期选项暂未开放，基础 24 小时冷静期仍可使用。"}}}},
    "intent.error.wishlistLimitReached": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your wishlist already has five open items. Finish or archive one before adding another."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"愿望清单已有 5 条进行中的项目，请先完成或归档一条再添加。"}}}},
    "intent.error.featureNotYetAvailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This Siri action is not available yet. You can still record an expense or check your budget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这项 Siri 操作暂未开放，你仍可使用 Siri 记支出或查询预算。"}}}},
    "insights.summary.thirtyDays": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Last 30 days"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"近 30 天"}}}},
    "insights.chart.thirtyDays": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"30-day trend"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"30 天趋势"}}}},
    "insights.savings.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Savings progress"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"储蓄进度"}}}},
    "insights.savings.target": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Total goal"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"总目标"}}}},
    "insights.savings.saved": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已储蓄"}}}},
    "insights.savings.remaining": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remaining"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"剩余金额"}}}},
    "insights.savings.progress": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Savings goal completion"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"储蓄目标完成进度"}}}},
    "insights.savings.percent": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%d%% complete"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成 %d%%"}}}},
    "insights.savings.empty": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Set a total savings goal in Settings to see progress across budget cycles."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在设置中建立总储蓄目标后，可在这里查看跨预算周期的进度。"}}}},
    "insights.savings.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Savings progress cannot be read right now. Your spending insights remain available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂时无法读取储蓄进度；其他消费洞察仍可继续查看。"}}}},
    "settings.releaseNotes.dailyRebalancing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Today now shows the exact daily amount recalculated from the remaining flexible budget after every entry, with allocation explanations in Budget settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“今天还可以花”现会在每次记账后，按剩余灵活预算重新计算当日具体金额；预算设置也会说明分配情况。"}}}},
    "settings.releaseNotes.faceIDLock": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional Face ID app lock protects local budget records on launch and after returning from the background."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新增可选的面容 ID 应用锁，可在启动及从后台返回时保护本地预算记录。"}}}},
    "settings.releaseNotes.incomeLedger": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use any Add entry action to choose expense or income, then record, edit, search, export, and delete exact income entries without changing the budget you set."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通过任一“记一笔”入口先选择支出或收入；逐笔收入可记录、编辑、搜索、导出和删除，且不会自动修改已设预算。"}}}},
    "settings.releaseNotes.thirtyDayInsights": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Insights now refreshes after saved entries and when opened, summarizing the latest 30 calendar days with on-device category, emotion, and daily trends."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"洞察现会在记录保存后和每次打开时刷新，并在本机统计最近 30 个日历日的分类、情绪及每日趋势。"}}}},
    "settings.releaseNotes.wishlistLimit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The free wishlist supports up to five open items, with the limit enforced consistently in the app and Siri actions."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"免费版愿望清单最多保留 5 条进行中的项目，App 与 Siri 操作会一致执行该上限。"}}}},
    "settings.releaseNotes.independentBudgetInputs": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Monthly income and spending budget stay independent during setup, so entering income never fills or overwrites the amount you plan to spend."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"首次设置时，月收入与支出预算保持独立；填写收入不会再自动填入或覆盖计划支出金额。"}}}},
    "settings.releaseNotes.insightsPartialData": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Insights keeps recorded expense totals visible but withholds narratives and pattern cards whenever related cooling-off data cannot be read completely."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"相关冷静期数据无法完整读取时，洞察会继续显示已记录的消费汇总，但不会生成周期叙述或模式卡片。"}}}},
    "settings.releaseNotes.dailyAllowanceDeduction": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Each flexible expense now reduces today's remaining amount one for one. The value stops at zero and explains when no daily amount is available, used, or exceeded."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每笔灵活支出现会按原金额扣减“今天还可以花”；最低显示 0，并会说明今日暂无可用额度、已经用完或已经超出。"}}}},
    "settings.releaseNotes.localizedLedgerFilters": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Log filters now show localized record and budget types instead of internal catalog keys."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"流水筛选现会正确显示本地化的流水类型与预算类型，不再出现内部键名。"}}}},
    "settings.releaseNotes.scrollableExpenseCategories": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expense entry now presents every category in one horizontally scrollable selector with an announced selected state."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"支出记账现使用可左右滑动的完整分类选择带，并会读出当前选中状态。"}}}},
    "insights.partialDataUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Some derived insights are unavailable because related local processing could not be completed. Your recorded expense summary is still shown."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分派生洞察暂时无法显示，因为相关本地处理未能完整完成；已记录的消费汇总仍可查看。"}}}},
    "settings.language.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App language"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"应用语言"}}}},
    "settings.language.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Language"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语言"}}}},
    "settings.language.footer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Changes MindBudget without changing the language of your iPhone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅切换花有数的界面语言，不会更改 iPhone 的系统语言。"}}}},
    "settings.language.system": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Follow System"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"跟随系统"}}}},
    "settings.language.zh-Hans": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Simplified Chinese"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"简体中文"}}}},
    "settings.language.en": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"English"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"English"}}}},
    "income.allocation.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allocate this income"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分配这笔收入"}}}},
    "income.allocation.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Optional. A budget allocation goes to the saved budget cycle containing this income date. Savings remain part of the separate total goal."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可选。预算分配会加入包含这个收入日期的已保存预算周期；储蓄仍计入独立的总目标。"}}}},
    "income.allocation.budget": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add to the dated budget cycle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"加入对应日期的预算周期"}}}},
    "income.allocation.savings": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Count toward savings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计入储蓄"}}}},
    "income.allocation.cycle.loading": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking the matching budget cycle…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在查找对应的预算周期…"}}}},
    "income.allocation.cycle.target": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Budget allocation target"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预算分配目标周期"}}}},
    "income.allocation.cycle.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No saved budget cycle contains this income date. Keep budget allocation at zero or choose a date in a saved cycle."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这个收入日期没有对应的已保存预算周期。请将预算分配保持为 0，或选择已有预算周期内的日期。"}}}},
    "income.allocation.cycle.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The matching budget cycle could not be read right now."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂时无法读取对应的预算周期。"}}}},
    "income.error.allocation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter nonnegative allocation amounts whose total does not exceed this income."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入非负分配金额，且两项合计不能超过这笔收入。"}}}},
    "income.error.budgetCycleUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This income cannot be added to a spending budget because its date is outside every saved budget cycle."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这笔收入的日期不在任何已保存的预算周期内，因此无法加入支出预算。"}}}},
    "expense.recurring.monthly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Repeat monthly as a fixed expense"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"设为每月固定支出"}}}},
    "expense.recurring.monthly.help": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Future occurrences use this day and time. If the app was closed, due entries are added once on the next launch."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"后续会沿用当前日期和时间；如果到期时 App 未运行，会在下次打开时补记一次。"}}}},
    "settings.savingsGoal.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Total savings goal"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"总储蓄目标"}}}},
    "settings.savingsGoal.progress": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Progress"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标进度"}}}},
    "settings.savingsGoal.saved": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Saved"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已储蓄"}}}},
    "settings.savingsGoal.remaining": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remaining"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"距离目标"}}}},
    "settings.savingsGoal.fromIncome": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allocated from income"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入分配累计"}}}},
    "settings.savingsGoal.plan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Goal"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标设置"}}}},
    "settings.savingsGoal.target": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Target amount"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标总额"}}}},
    "settings.savingsGoal.startingBalance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Already saved"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已有储蓄"}}}},
    "settings.savingsGoal.footer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This goal continues across cycles. It is separate from the savings reservation inside each budget cycle."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这个目标会跨预算周期持续存在，与每个周期内预留的储蓄金额相互独立。"}}}},
    "settings.savingsGoal.error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check the target and saved amounts, then try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请检查目标总额和已有储蓄金额后重试。"}}}},
    "settings.savingsGoal.delete": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete savings goal"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除储蓄目标"}}}},
    "settings.savingsGoal.delete.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete this savings goal?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除这个储蓄目标？"}}}},
    "settings.savingsGoal.delete.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Income records and their allocations stay in your ledger."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入流水及其分配记录仍会保留。"}}}},
    "settings.recurring.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recurring fixed expenses"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每月固定支出"}}}},
    "settings.recurring.empty.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No recurring expenses"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂无每月固定支出"}}}},
    "settings.recurring.empty.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn on Repeat monthly when recording an expense."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记支出时开启“设为每月固定支出”即可添加。"}}}},
    "settings.recurring.footer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rules begin after your confirmation. Missed due entries are reconciled once when the app next opens; history is never deleted with a rule."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"规则从确认后开始；到期时未打开 App，会在下次启动时去重补记。删除规则不会删除历史流水。"}}}},
    "settings.recurring.reconcile.error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Some recurring entries could not be reconciled. No partial batch was saved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分固定支出暂时无法补记，本次不会保存不完整批次。"}}}},
    "settings.recurring.reconcile.pending": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Some earlier recurring expenses are still being added. MindBudget will continue the next time the app becomes active."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仍有较早的固定支出待补记，下次回到 App 时会继续处理。"}}}},
    "settings.recurring.rule": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Monthly rule"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每月规则"}}}},
    "settings.recurring.anchor": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Day and time"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"日期和时间"}}}},
    "settings.recurring.active": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Active"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"启用规则"}}}},
    "settings.recurring.edit.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Edit recurring expense"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"编辑每月固定支出"}}}},
    "settings.recurring.edit.footer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Changes affect future occurrences only."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"修改仅影响尚未生成的后续流水。"}}}},
    "settings.recurring.error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check the amount, date, and category, then try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请检查金额、日期和分类后重试。"}}}},
    "settings.releaseNotes.appLanguage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose Follow System, Simplified Chinese, or English inside the app without changing the iPhone language."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可在 App 内选择跟随系统、简体中文或 English，无需修改 iPhone 系统语言。"}}}},
    "settings.releaseNotes.incomeAllocation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allocate each income explicitly to this cycle's spending budget, savings, or neither; recording income alone still changes nothing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每笔收入可明确分配到本周期预算、储蓄或暂不分配；仅记录收入仍不会自动改变预算。"}}}},
    "settings.releaseNotes.globalSavingsGoal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Added one total savings goal with progress across budget cycles, separate from per-cycle savings reservations."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新增跨周期总储蓄目标及进度，并与每周期储蓄预留保持独立。"}}}},
    "settings.releaseNotes.recurringFixedExpenses": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirmed monthly fixed expenses now reconcile once with duplicate protection, plus edit, pause, and delete controls."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新增用户确认的每月固定支出：支持去重补记，并可编辑、暂停或删除规则。"}}}},
    "settings.releaseNotes.paceAppIcon": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Refined the app icon with a larger budget-pace mark for clearer recognition in standard, dark, and tinted appearances."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更新应用图标，放大预算节奏标记，并优化标准、深色与单色外观下的辨识度。"}}}},
    "settings.releaseNotes.subscriptionExperience": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget Pro now has a voluntary StoreKit screen with live Monthly and Annual terms, explicit purchase, Restore Purchases, and subscription management."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新增可自主打开的花有数 Pro 页面：由 StoreKit 显示实时月付、年付条款，并提供明确的购买、恢复购买与订阅管理操作。"}}}},
    "settings.releaseNotes.trialLifecycle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Eligible Pro trials use verified StoreKit renewal facts for their date and next plan, with a quiet in-app reminder or one generic local reminder when notifications are already allowed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"符合条件的 Pro 试用会根据经 StoreKit 验证的续费日期与下一套餐展示；若通知已允许，可使用一条不含金额的本地提醒，否则仅在 App 内温和提示。"}}}},
    "settings.releaseNotes.subscriptionGuidance": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Billing grace, retry, expiry, and revocation now have calm bilingual guidance without hiding local records; uncertain StoreKit authority pauses purchase instead of being described as Free."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账单宽限期、重试、到期与撤销现会显示温和的双语说明，不会隐藏本地记录；StoreKit 权威暂时无法确认时会暂停购买，而不会误述为免费状态。"}}}},
    "settings.releaseNotes.insightsReview": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Insights no longer replays an old point-in-time budget buffer as a current balance, and its 30-day category breakdown is now a lossless, accessible donut chart."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"洞察不再把过去某一刻的“预算仍有缓冲”当作当前余额重放；近 30 天分类统计现改为无损且支持辅助功能的环形图。"}}}},
    "settings.releaseNotes.simplifiedBudgetSetup": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Budget setup now uses this month's income plus explicitly allocated extra income, minus the savings goal, as the disposable amount. Expected expenses remains a pace reference, and fixed expenses come from actual or recurring entries."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预算设置现按“本月收入＋明确分配的额外收入－储蓄目标”计算本期可支配金额；“预计支出”仅用于节奏参考，固定支出只从实际或周期流水产生。"}}}},
    "settings.releaseNotes.savingsProgress": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Insights now shows total savings target, confirmed savings, remaining amount, and exact completion progress in a separate module."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"洞察新增独立的储蓄进度模块，展示总目标、已确认储蓄、剩余金额和精确完成比例。"}}}},
    "settings.releaseNotes.aiAppLanguage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device wording enhancement now checks and follows the language selected inside the app, with a clear recovery message when that language is unsupported."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机文字增强现会检查并遵循 App 内选择的语言；若该语言不受支持，会提供明确的切换提示。"}}}},
    "settings.releaseNotes.truthfulCycleUsage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cycle Overview now distinguishes positive use below 1%, exactly zero spending, and a missing budget baseline instead of describing different states as 0%."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"周期概览现会区分正数但不足 1%、恰好零支出和无可用预算基线，不再将不同状态都显示为 0%。"}}}},
    "settings.releaseNotes.askFallbackReasons": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask now explains why a complete local answer was used, distinguishing unavailable enhancement, timeout, safety validation, and model errors."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Ask 现会说明为何使用完整本地回答，并区分增强不可用、请求超时、安全校验未通过和模型错误。"}}}},
    "settings.budget.recordedIncome": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recorded income this cycle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期已记录收入"}}}},
    "settings.budget.incomeAllocated": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Added to spending budget"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已加入支出预算"}}}},
    "settings.budget.incomeSaved": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Allocated to savings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已计入储蓄"}}}},
    "commerce.pro.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget Pro"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数 Pro"}}}},
    "commerce.pro.subtitle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unlock additional on-device tools while keeping MindBudget local-first."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解锁更多本机工具，同时保持花有数的本地优先原则。"}}}},
    "commerce.pro.active": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pro subscription active"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Pro 订阅已生效"}}}},
    "commerce.pro.includes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Included today"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前包含"}}}},
    "commerce.pro.feature.ai": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple on-device wording enhancement"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 本机文字增强"}}}},
    "commerce.pro.feature.cooling": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"72-hour and custom cooling-off periods"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"72 小时及自定义冷静期"}}}},
    "commerce.pro.feature.siri": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Advanced Siri wishlist, cooling-off, emotion, and pattern actions"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"高级 Siri 心愿单、冷静期、情绪与模式操作"}}}},
    "commerce.pro.localFirst": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your budget records remain on your device. Apple handles subscription payment and status."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预算记录仍保留在设备上；订阅付款与状态由 Apple 处理。"}}}},
    "commerce.pro.plans": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择套餐"}}}},
    "commerce.pro.monthly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Monthly"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"月付"}}}},
    "commerce.pro.annual": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Annual"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"年付"}}}},
    "commerce.pro.perMonth": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"per month"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每月"}}}},
    "commerce.pro.perYear": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"per year"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每年"}}}},
    "commerce.pro.plan.accessibility.monthly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Monthly plan, %@ per month"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"月付套餐，每月 %@"}}}},
    "commerce.pro.plan.accessibility.annual": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Annual plan, %@ per year"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"年付套餐，每年 %@"}}}},
    "commerce.pro.plan.selected": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selected"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已选择"}}}},
    "commerce.pro.plan.selectHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Selects this subscription plan."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择此订阅套餐。"}}}},
    "commerce.pro.trial.eligible": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Eligible for a free trial"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"符合免费试用资格"}}}},
    "commerce.pro.trial.lifecycle.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your trial"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的试用"}}}},
    "commerce.pro.trial.lifecycle.active": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Free trial active"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"免费试用进行中"}}}},
    "commerce.pro.trial.lifecycle.renews": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Renews on %1$@ at the current App Store price of %2$@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将于 %1$@ 按 App Store 当前价格 %2$@ 续订。"}}}},
    "commerce.pro.trial.lifecycle.renewsDateOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Renews on %@. Refresh the App Store plans to confirm the current price."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将于 %@ 续订。请刷新 App Store 套餐以确认当前价格。"}}}},
    "commerce.pro.trial.lifecycle.notRenewing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This trial is not scheduled to renew automatically."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此试用当前不会自动续订。"}}}},
    "commerce.pro.trial.lifecycle.dateUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The App Store has not provided a reliable renewal date, so no reminder is scheduled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"App Store 尚未提供可靠的续订日期，因此不会安排提醒。"}}}},
    "commerce.pro.trial.lifecycle.reminderScheduled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A generic local reminder is scheduled before renewal."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已在续订前安排一条不含价格与私密数据的本地提醒。"}}}},
    "commerce.pro.trial.lifecycle.inAppOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A notification is not available; this in-app reminder remains visible."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前无法发送通知；此 App 内提醒仍会保留。"}}}},
    "commerce.pro.trial.lifecycle.noReminder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No renewal notification is scheduled for the current verified state."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"根据当前已验证状态，未安排续订通知。"}}}},
    "commerce.pro.trial.lifecycle.reminderFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The reminder could not be updated. The verified renewal details above remain available in the app."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂时无法更新提醒；上方已验证的续订信息仍可在 App 内查看。"}}}},
    "notification.trialRenewal.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget Pro trial"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"花有数 Pro 试用"}}}},
    "notification.trialRenewal.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your Pro trial ends soon. Open MindBudget to review its current status."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的 Pro 试用即将结束。打开花有数查看当前状态。"}}}},
    "commerce.pro.catalog.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plans are temporarily unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"套餐暂时无法读取"}}}},
    "commerce.pro.catalog.unavailable.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No price will be guessed. Check your connection and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不会猜测价格，请检查网络后重试。"}}}},
    "commerce.pro.catalog.cached": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Showing a previously loaded price. Refresh before subscribing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前显示此前读取的价格，订阅前请先刷新。"}}}},
    "commerce.pro.startTrial": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start free trial"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始免费试用"}}}},
    "commerce.pro.continue": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Continue"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续"}}}},
    "commerce.pro.disclosure.monthlyTrial": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%1$@ free, then %2$@ per month. Renews automatically unless cancelled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"前 %1$@ 免费，之后每月 %2$@。如未取消将自动续订。"}}}},
    "commerce.pro.disclosure.annualTrial": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%1$@ free, then %2$@ per year. Renews automatically unless cancelled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"前 %1$@ 免费，之后每年 %2$@。如未取消将自动续订。"}}}},
    "commerce.pro.disclosure.monthly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ per month. Renews automatically unless cancelled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每月 %@。如未取消将自动续订。"}}}},
    "commerce.pro.disclosure.annual": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ per year. Renews automatically unless cancelled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每年 %@。如未取消将自动续订。"}}}},
    "commerce.pro.purchase.footer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple confirms the purchase before charging your Apple Account. You can cancel in App Store subscription settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 会在扣款前请你确认购买；你可以在 App Store 的订阅设置中取消。"}}}},
    "commerce.pro.purchase.hint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple will show the final subscription terms before confirming."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认前，Apple 会显示最终订阅条款。"}}}},
    "commerce.pro.status.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscription status"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"订阅状态"}}}},
    "commerce.pro.status.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscription status cannot be confirmed. Purchases are paused to prevent an unintended subscription change."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂时无法确认订阅状态。为避免意外变更订阅，购买已暂停。"}}}},
    "commerce.pro.status.recheck": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recheck Subscription Status"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重新检查订阅状态"}}}},
    "commerce.pro.status.grace.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Payment method needs attention"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"付款方式需要处理"}}}},
    "settings.icloudSync.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync with iCloud"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 iCloud 同步"}}}},
    "settings.icloudSync.status": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Status"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"状态"}}}},
    "settings.icloudSync.pending": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pending changes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"待同步更改"}}}},
    "settings.icloudSync.needsReview": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Needs review"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要检查"}}}},
    "settings.icloudSync.enable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable iCloud Sync"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开启 iCloud 同步"}}}},
    "settings.icloudSync.disable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Turn Off Sync"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭同步"}}}},
    "settings.icloudSync.retry": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Retry Sync"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重试同步"}}}},
    "settings.icloudSync.disable.footer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Turning sync off keeps local data and the existing iCloud copy. Delete iCloud Data is a separate confirmed action that keeps this device's local records."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关闭同步会保留本地数据和现有 iCloud 副本。“删除 iCloud 数据”是另一个需确认的操作，并会保留这台设备上的本地记录。"}}}},
    "settings.icloudSync.confirm.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Sync with iCloud?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开启使用 iCloud 同步？"}}}},
    "settings.icloudSync.confirm.enable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable Sync"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开启同步"}}}},
    "settings.icloudSync.disclosure": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"When enabled, MindBudget stores your financial records, budgets, savings goals, wishlist and cooling-off plans, notes, and reflections in your private iCloud database and syncs them across devices signed in to the same Apple Account. Receipt images, OCR data, reminder history, diagnostics, and local recovery files are not uploaded. Sync is off by default, and local use continues when iCloud is unavailable. Turning sync off keeps local data and does not delete the iCloud copy; deleting cloud data is a separate confirmed action."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开启后，花有数会将你的收支记录、预算、储蓄目标、愿望清单与冷静期计划、备注和复盘内容存入你的私人 iCloud 数据库，并在登录同一 Apple 账户的设备间同步。收据图片、OCR 数据、提醒历史、诊断信息和本地恢复文件不会上传。同步默认关闭；iCloud 不可用时仍可在本机使用。关闭同步会保留本地数据，也不会删除 iCloud 副本；删除云端数据是另一个需确认的操作。"}}}},
    "settings.icloudSync.reimport.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"An iCloud copy may still exist. Enabling sync can import those records back to this device and can upload this device's current local records. Continue only if you want to combine this device with that private iCloud copy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iCloud 中可能仍保留副本。开启同步可能会将这些记录重新导入本机，也可能上传本机当前的本地记录。只有在你希望将本机与该私人 iCloud 副本合并时才继续。"}}}},
    "settings.icloudSync.deleteCloud": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete iCloud Data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除 iCloud 数据"}}}},
    "settings.icloudSync.deleteCloud.confirm.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete All MindBudget Data from iCloud?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除 iCloud 中所有花有数数据？"}}}},
    "settings.icloudSync.deleteCloud.confirm.action": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete from iCloud"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从 iCloud 删除"}}}},
    "settings.icloudSync.deleteCloud.confirm.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This permanently deletes MindBudget's private CloudKit zone for this Apple Account and turns sync off. Records on this device stay available. Other devices stop and require an explicit recovery choice."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会永久删除此 Apple 账户下花有数的私人 CloudKit 区域，并关闭同步。本机记录会保留；其他设备将停止同步并需要明确选择恢复方式。"}}}},
    "settings.icloudSync.recovery.rebuild": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rebuild iCloud from This Device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"用本机数据重建 iCloud"}}}},
    "settings.icloudSync.recovery.confirm.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use This Device as the New Cloud Source?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将本机作为新的云端数据来源？"}}}},
    "settings.icloudSync.recovery.confirm.action": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rebuild from This Device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从本机重建"}}}},
    "settings.icloudSync.recovery.confirm.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This discards this device's old sync ancestry and uses its current local records as the new cloud source for the Apple Account now signed in. If that account already has a MindBudget copy, its records may be imported and any true divergence remains quarantined for review. Check this device's local records before continuing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会丢弃本机原有的同步继承链，并将当前本地记录作为当前已登录 Apple 账户的新云端数据来源。如果该账户已有花有数副本，其记录可能被导入；真实分歧仍会隔离等待检查。继续前请检查本机记录。"}}}},
    "settings.icloudSync.status.disabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Off"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已关闭"}}}},
    "settings.icloudSync.status.syncing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Syncing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在同步"}}}},
    "settings.icloudSync.status.ready": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Up to date"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已是最新"}}}},
    "settings.icloudSync.status.offline": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Waiting for network"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在等待网络"}}}},
    "settings.icloudSync.status.account": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Account unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 账户不可用"}}}},
    "settings.icloudSync.status.quota": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"iCloud storage unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iCloud 存储空间不可用"}}}},
    "settings.icloudSync.status.accountChanged": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paused after Apple Account change"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 账户更改后已暂停"}}}},
    "settings.icloudSync.status.encryptedReset": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paused after encrypted-data reset"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"加密数据重置后已暂停"}}}},
    "settings.icloudSync.status.remoteZoneDeleted": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Paused after iCloud data was removed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iCloud 数据被移除后已暂停"}}}},
    "settings.icloudSync.status.deletingCloudData": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deleting iCloud data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在删除 iCloud 数据"}}}},
    "settings.icloudSync.deleteCloud.guidance.pending": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion is still pending. You can retry; MindBudget will not recreate the zone or upload local records while this operation is pending."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除仍在等待完成。你可以重试；在此操作完成前，花有数不会重建云端区域或上传本机记录。"}}}},
    "settings.icloudSync.deleteCloud.guidance.network": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion is waiting for iCloud network service. Retry when connectivity returns; local records will not be uploaded while deletion is pending."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除正在等待 iCloud 网络服务。网络恢复后可重试；删除待完成期间不会上传本机记录。"}}}},
    "settings.icloudSync.deleteCloud.guidance.account": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion is waiting for the same available Apple Account. Sign in to that account and retry; MindBudget will not reupload local records meanwhile."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除正在等待原 Apple 账户可用。请登录该账户后重试；在此期间，花有数不会重新上传本机记录。"}}}},
    "settings.icloudSync.deleteCloud.guidance.quota": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"iCloud storage is currently unavailable for deletion. Retry later; local records remain on this device and will not be reuploaded."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iCloud 存储目前无法完成删除。请稍后重试；本机记录会继续保留，且不会重新上传。"}}}},
    "settings.icloudSync.deleteCloud.guidance.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"iCloud deletion could not be confirmed. Retry is safe: the operation stays pending and MindBudget will not recreate or repopulate the zone."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法确认 iCloud 删除已完成。可安全重试；操作会继续保持待完成，花有数不会重建或回填云端区域。"}}}},
    "settings.icloudSync.status.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sync unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"同步暂不可用"}}}},
    "settings.icloudSync.conflicts.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review Sync Conflicts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查同步冲突"}}}},
    "settings.icloudSync.conflicts.empty.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No Conflicts to Review"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有待检查的冲突"}}}},
    "settings.icloudSync.conflicts.empty.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget will keep any malformed or unverifiable cloud record quarantined rather than guessing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"对格式异常或无法验证的云端记录，花有数会继续隔离，而不会猜测处理。"}}}},
    "settings.icloudSync.conflicts.type": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Record type"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录类型"}}}},
    "settings.icloudSync.conflicts.local": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机"}}}},
    "settings.icloudSync.conflicts.cloud": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"iCloud"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"iCloud"}}}},
    "settings.icloudSync.conflicts.keepLocal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep This Device's Version"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留本机版本"}}}},
    "settings.icloudSync.conflicts.useCloud": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use iCloud Version"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用 iCloud 版本"}}}},
    "settings.icloudSync.conflicts.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This record cannot be safely resolved in the app. It remains quarantined and does not replace local data."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此记录无法在应用内安全解决，将继续隔离，且不会替换本地数据。"}}}},
    "settings.icloudSync.conflicts.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only the record type and whether each side keeps or deletes it are shown here. Financial values and notes stay private."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此处只显示记录类型以及两端是保留还是删除；金额和备注保持私密。"}}}},
    "settings.icloudSync.conflicts.confirm.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Resolve This Conflict?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"解决此同步冲突？"}}}},
    "settings.icloudSync.conflicts.confirm.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your choice creates a new accepted sync revision. MindBudget never chooses a winner automatically."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的选择会创建一个新的已接受同步版本。花有数绝不会自动选择胜出方。"}}}},
    "settings.icloudSync.conflicts.operation.keep": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keeps record"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"保留记录"}}}},
    "settings.icloudSync.conflicts.operation.delete": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletes record"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除记录"}}}},
    "settings.icloudSync.conflicts.operation.unknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法确认"}}}},
    "settings.icloudSync.conflicts.entity.expense": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expense"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"支出"}}}},
    "settings.icloudSync.conflicts.entity.income": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Income"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入"}}}},
    "settings.icloudSync.conflicts.entity.savingsGoal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Savings goal"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"储蓄目标"}}}},
    "settings.icloudSync.conflicts.entity.budgetPlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Budget plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预算计划"}}}},
    "settings.icloudSync.conflicts.entity.budgetPlanSemantics": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Budget basis"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预算口径"}}}},
    "settings.icloudSync.conflicts.entity.categoryBudget": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Category budget"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分类预算"}}}},
    "settings.icloudSync.conflicts.entity.incomeAllocation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Income allocation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"收入分配"}}}},
    "settings.icloudSync.conflicts.entity.wishlistItem": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wishlist item"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"愿望清单项"}}}},
    "settings.icloudSync.conflicts.entity.coolingOffPlan": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cooling-off plan"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期计划"}}}},
    "settings.icloudSync.conflicts.entity.reflectionLog": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Reflection"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"复盘"}}}},
    "settings.icloudSync.conflicts.entity.recurringRule": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recurring expense"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"固定支出"}}}},
    "settings.icloudSync.conflicts.entity.recurringOccurrence": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recurring occurrence"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"周期支出发生记录"}}}},
    "settings.icloudSync.conflicts.entity.unknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unverifiable record"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法验证的记录"}}}},
    "commerce.pro.status.grace.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pro remains active during Apple’s billing grace period. Manage your subscription to update the payment method."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Apple 的账单宽限期内，Pro 仍可使用。请前往订阅管理更新付款方式。"}}}},
    "commerce.pro.status.retry.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pro access is paused"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Pro 权限已暂停"}}}},
    "commerce.pro.status.retry.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple is retrying the subscription payment. Your local records and Free tools remain available; manage the subscription to resolve the billing issue."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 正在重试订阅付款。本地记录和 Free 工具仍可使用；请前往订阅管理处理付款问题。"}}}},
    "commerce.pro.status.expired.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your Pro subscription ended"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的 Pro 订阅已到期"}}}},
    "commerce.pro.status.expired.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your local records and Free tools remain available. You can review the current App Store plans if you want to subscribe again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地记录和 Free 工具仍可使用；如需再次订阅，可查看 App Store 当前提供的套餐。"}}}},
    "commerce.pro.status.revoked.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscription access was removed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"订阅权限已移除"}}}},
    "commerce.pro.status.revoked.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple reports that this subscription no longer grants Pro access. Your local records and Free tools remain available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 显示此订阅已不再提供 Pro 权限。本地记录和 Free 工具仍可使用。"}}}},
    "commerce.pro.status.openHint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens subscription details and controls."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开订阅详情与管理选项。"}}}},
    "commerce.pro.offer.unsupported": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This introductory offer uses a paid billing mode that MindBudget does not support yet. Purchase is paused so its price and schedule cannot be misstated."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此首购优惠采用花有数暂未支持的付费计费方式。为避免错误说明价格和扣费周期，购买已暂停。"}}}},
    "commerce.pro.account": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscription controls"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"订阅管理"}}}},
    "commerce.pro.restore": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Restore Purchases"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"恢复购买"}}}},
    "commerce.pro.manage": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Manage Subscription"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"管理订阅"}}}},
    "commerce.pro.legal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Information"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"相关信息"}}}},
    "commerce.pro.terms.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscription Terms"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"订阅条款"}}}},
    "commerce.pro.privacy.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscription Privacy"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"订阅隐私"}}}},
    "commerce.pro.testTerms": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Price, currency, and trial eligibility are supplied by the App Store for your storefront."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"价格、币种和试用资格均由 App Store 按你所在的商店地区提供。"}}}},
    "commerce.pro.aiValueTrigger": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"See Pro options for on-device enhancement"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看本机增强的 Pro 选项"}}}},
    "commerce.pro.notice.purchased": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscription confirmed. Pro access is active."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"订阅已确认，Pro 权限已生效。"}}}},
    "commerce.pro.notice.pending": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Purchase is pending Apple approval. No Pro access was granted yet."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"购买正在等待 Apple 批准，Pro 权限尚未生效。"}}}},
    "commerce.pro.notice.cancelled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Purchase was cancelled. Nothing changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"购买已取消，当前状态没有变化。"}}}},
    "commerce.pro.notice.restored": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your active subscription was restored."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"有效订阅已恢复。"}}}},
    "commerce.pro.notice.noActive": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No active MindBudget Pro subscription was found."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未找到有效的花有数 Pro 订阅。"}}}},
    "commerce.pro.notice.inProgress": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Another subscription operation is still in progress."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"另一项订阅操作仍在进行中。"}}}},
    "commerce.pro.notice.productUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This plan is currently unavailable. No purchase was made."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前套餐暂时不可用，未发生购买。"}}}},
    "commerce.pro.notice.purchasesNotAllowed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Purchases are not allowed for this Apple Account or device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前 Apple 账户或设备不允许购买。"}}}},
    "commerce.pro.notice.verificationFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The purchase could not be verified. Pro access was not granted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"购买暂时无法验证，Pro 权限未生效。"}}}},
    "commerce.pro.notice.invalidState": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The App Store state could not be confirmed. Try again later."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂时无法确认 App Store 状态，请稍后重试。"}}}},
    "commerce.pro.notice.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscription service is temporarily unavailable. Nothing changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"订阅服务暂时不可用，当前状态没有变化。"}}}},
    "commerce.pro.terms.subscription": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Plans"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"套餐"}}}},
    "commerce.pro.terms.renewal": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Subscriptions renew automatically at the displayed App Store price unless cancelled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如未取消，订阅将按 App Store 显示的价格自动续订。"}}}},
    "commerce.pro.terms.trial": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A free trial is shown only when the App Store confirms its length and your eligibility. After the trial, the selected plan renews at its displayed price."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅当 App Store 确认试用时长与资格时才会显示免费试用；试用结束后，所选套餐将按显示价格续订。"}}}},
    "commerce.pro.terms.control": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your control"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的控制权"}}}},
    "commerce.pro.terms.control.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Purchase, restore, and subscription management run only after you tap the corresponding control. You can manage or cancel through Apple at any time."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"购买、恢复和订阅管理只会在你点击相应按钮后进行；你可以随时通过 Apple 管理或取消。"}}}},
    "commerce.pro.privacy.storekit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple and StoreKit"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple 与 StoreKit"}}}},
    "commerce.pro.privacy.storekit.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple handles payment, storefront price, eligibility, and subscription status. MindBudget does not receive your payment-card details."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"付款、商店价格、试用资格和订阅状态由 Apple 处理；花有数不会收到你的银行卡信息。"}}}},
    "commerce.pro.privacy.local": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local budget data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地预算数据"}}}},
    "commerce.pro.privacy.local.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your ledger, notes, savings goals, and questions are not included in StoreKit purchase requests. Subscription authority is not stored as a permanent local unlock."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"账本、备注、储蓄目标和问题不会进入 StoreKit 购买请求；订阅权限也不会作为永久本地解锁状态保存。"}}}}
  },
  "version": "1.0"
}
