        "zh-Hans": { "stringUnit": { "state": "translated", "value": "历史版本" } }
      }
    },
    "settings.releaseNotes.history.footer": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Only the installed version's notes stay open. Earlier versions are kept here and remain collapsed by default." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "仅当前安装版本的更新内容默认展开；较早版本保留在这里，并默认收起。" } }
      }
    },
    "settings.releaseNotes.title": {
      "localizations": {
