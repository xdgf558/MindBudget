    "dashboard.available.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexible money available after spending and unpaid fixed expenses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扣除已消费与尚未支付的固定支出后，可灵活使用的金额。"
          }
        }
      }
    },
    "dashboard.available.negative": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your flexible budget is below zero. Review the plan when convenient."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
