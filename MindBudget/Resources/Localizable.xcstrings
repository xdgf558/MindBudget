    "settings.ai.debug.validation.missingContinuePurchase": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Continue option missing"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"缺少继续购买选项"}}}},
