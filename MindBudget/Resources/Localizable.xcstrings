    "settings.notifications.invalidStoredData.count": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unreadable cooling-off records found: %d. Other valid reminders were still updated."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"发现 %d 条无法读取的冷静期记录，其他有效提醒仍已更新。"}}}},
    "settings.notifications.repair.action": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review and remove unreadable records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看并移除无法读取的记录"}}}},
    "settings.notifications.repair.confirm.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove unreadable cooling-off records?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除无法读取的冷静期记录？"}}}},
    "settings.notifications.repair.confirm.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Identified records: %d. Each record is checked again and removed only if it is still unreadable. Expenses, wishlist items, and readable cooling-off history stay unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已识别 %d 条记录。每条记录都会再次检查，仅在仍无法读取时移除。消费、心愿项以及可读取的冷静期历史不会改变。"}}}},
    "settings.notifications.repair.confirm.action": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Remove unreadable records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移除无法读取的记录"}}}},
    "settings.notifications.repair.progress": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking and removing unreadable records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查并移除无法读取的记录"}}}},
    "settings.notifications.repair.completed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unreadable cooling-off records removed: %d."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已移除 %d 条无法读取的冷静期记录。"}}}},
    "settings.notifications.repair.failed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unreadable records could not be removed. Nothing else was deleted."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取的记录未能移除，其他内容未被删除。"}}}},
    "settings.notifications.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Lock-screen notifications show the wishlist item name, but never its amount or notes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"锁屏通知会显示愿望名称，但不会显示金额或备注。"}}}},
    "wishlist.cooling.notification": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notify me when it is ready to review"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"到期时通知我回看"}}}},
    "wishlist.cooling.notificationPrivacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The notification shows this item name, but not its price or notes. Quiet hours may defer delivery."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"通知会显示愿望名称，不显示价格或备注；静默时段内会顺延送达。"}}}},
    "wishlist.cooling.error.notificationsDenied": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The cooling-off period started, but notifications are blocked. You can enable them in System Settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期已经开始，但系统通知权限未开启；你可以前往系统设置开启。"}}}},
    "wishlist.cooling.error.notificationScheduling": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The cooling-off period started, but its notification could not be scheduled. Your local countdown is still available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期已经开始，但通知未能安排；本地倒计时仍可正常使用。"}}}},
    "export.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Export CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"导出 CSV"}}}},
    "export.localOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The file is prepared on this device and shared only where you choose."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"文件只在本机生成，并仅分享至你选择的位置。"}}}},
    "export.includes": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The CSV contains expense dates, exact amounts, categories, optional merchant names, and raw notes. It does not contain inferred advice."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CSV 包含消费日期、精确金额、分类、可选商户名和原始备注，不包含推断建议。"}}}},
    "export.spreadsheetSafety": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Text that resembles a spreadsheet formula is prefixed with an apostrophe for safety."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为避免电子表格公式执行，疑似公式的文本会加英文单引号前缀。"}}}},
    "export.file.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Expense file"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"消费记录文件"}}}},
    "export.recordCount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录数"}}}},
    "export.preparing": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Preparing CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在生成 CSV"}}}},
    "export.share": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Share CSV"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分享 CSV"}}}},
    "export.error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The CSV could not be prepared. Your stored data was not changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"CSV 未能生成，已存数据没有发生变化。"}}}},
    "privacy.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Privacy controls"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"隐私控制"}}}},
    "privacy.summary.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How data is handled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"数据如何处理"}}}},
    "privacy.summary.deviceOnly": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Financial records stay on this device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"财务记录只保留在本机"}}}},
    "privacy.summary.noTracking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No ads, tracking, or third-party analytics"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无广告、追踪或第三方分析"}}}},
    "privacy.summary.noAccount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No account or cloud sync in V1"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"V1 无账号或云同步"}}}},
    "privacy.summary.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget does not sell or share your records. System notifications are local and can be disabled at any time."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MindBudget 不出售或分享你的记录；系统通知仅在本机运行，并可随时关闭。"}}}},
    "privacy.delete.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete all data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除所有数据"}}}},
    "privacy.delete.explanation": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cancels MindBudget notifications, clears its system search index, removes every local record, resets app preferences, and returns to onboarding."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此操作会取消 MindBudget 通知、清空系统搜索索引、移除全部本地记录、重置应用偏好，并返回初始引导。"}}}},
    "privacy.delete.start": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete all local data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除全部本地数据"}}}},
    "privacy.delete.first.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete everything in MindBudget?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除 MindBudget 中的全部内容？"}}}},
    "privacy.delete.first.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cannot be undone. Export your expense CSV first if you need a copy."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此操作无法撤销。如需保留副本，请先导出消费 CSV。"}}}},
    "privacy.delete.first.continue": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Continue to final confirmation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续最终确认"}}}},
    "privacy.delete.final.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Final confirmation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最终确认"}}}},
    "privacy.delete.final.message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter the confirmation word shown below. Deletion starts only after you tap the final button."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入下方确认词；只有点击最终按钮后才会开始删除。"}}}},
    "privacy.delete.final.placeholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Confirmation word"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认词"}}}},
    "privacy.delete.final.hint": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter DELETE"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入“删除”"}}}},
    "privacy.delete.confirmationWord": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"DELETE"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除"}}}},
    "privacy.delete.final.action": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Permanently delete all data"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"永久删除全部数据"}}}},
    "privacy.delete.progress.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion progress"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除进度"}}}},
    "privacy.delete.failure.incomplete": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deletion is incomplete and has not been reported as successful. You can retry the full sequence."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除尚未完整完成，应用不会显示成功；你可以重试完整流程。"}}}},
    "privacy.delete.stage.cancellingNotifications": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancelling notifications"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在取消通知"}}}},
    "privacy.delete.stage.clearingSearchIndex": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Clearing the system search index"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在清空系统搜索索引"}}}},
    "privacy.delete.stage.deletingLocalData": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Deleting local records"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在删除本地记录"}}}},
    "privacy.delete.stage.resettingPreferences": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Resetting app preferences"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在重置应用偏好"}}}},
    "privacy.delete.failure.cancellingNotifications": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Notifications could not be fully cancelled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能完整取消通知"}}}},
    "privacy.delete.failure.clearingSearchIndex": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The system search index could not be fully cleared"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能完整清空系统搜索索引"}}}},
    "privacy.delete.failure.deletingLocalData": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local records could not be fully deleted"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能完整删除本地记录"}}}},
    "privacy.delete.failure.resettingPreferences": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App preferences could not be fully reset"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未能完整重置应用偏好"}}}},
    "export.filename": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget expenses"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MindBudget 消费记录"}}}},
    "export.filename.value": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget-Expenses.csv"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MindBudget-消费记录.csv"}}}},
    "notification.cooling.itemFallback": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"your wishlist item"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这个愿望"}}}},
    "common.notSet": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not set"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未设置"}}}},
    "ask.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask MindBudget"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"问 MindBudget"}}}},
    "ask.dashboard.prompt": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask about your budget"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"问问你的预算"}}}},
    "ask.question.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your question"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你的问题"}}}},
    "ask.question.placeholder": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What would you like to know?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你想了解什么？"}}}},
    "ask.suggestion.remaining": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"How much is left?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这个周期还剩多少？"}}}},
    "ask.suggestion.stress": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Any stress pattern?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"有压力消费的模式吗？"}}}},
    "ask.suggestion.wishlist": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wishlist status"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"愿望清单状态"}}}},
    "ask.purchase.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Purchase details"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"购买信息"}}}},
    "ask.purchase.amount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Amount"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额"}}}},
    "ask.purchase.category": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Category"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分类"}}}},
    "ask.purchase.amountError": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a valid amount for this currency."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入该币种支持的有效金额。"}}}},
    "ask.purchase.clarification": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Amount and category are used only for this answer and are not saved."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"金额和分类只用于本次回答，不会保存。"}}}},
    "ask.submit": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Get answer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"获取回答"}}}},
    "ask.answer.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Answer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"回答"}}}},
    "ask.answer.enhanced": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device enhanced"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机增强"}}}},
    "ask.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Your question is classified on this device and is never saved. AI enhancement receives only allow-listed aggregate facts, never notes or transaction rows."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"问题只在本机分类且不会保存。AI 增强只接收明确允许的聚合事实，不接收备注或逐笔记录。"}}}},
    "ask.answer.canIAfford.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Budget check"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"预算检查"}}}},
    "ask.answer.canIAfford.clarify": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add an amount and category so I can calculate the impact without guessing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请补充金额和分类，我会据此计算影响，不猜测数值。"}}}},
    "ask.answer.canIAfford.within": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is within the currently available %@. You can still choose to pause or continue."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 在当前可用的 %@ 之内。你仍可以选择暂缓或继续。"}}}},
    "ask.answer.canIAfford.outside": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ is above the currently available %@. A pause or budget adjustment may help."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 高于当前可用的 %@。可以先暂缓，或调整预算。"}}}},
    "ask.answer.remainingBudget.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Budget remaining"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"剩余预算"}}}},
    "ask.answer.remainingBudget.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You have %@ in flexible budget left. The calculated daily amount is %@ for %d remaining days."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"灵活预算还剩 %@。余下 %3$d 天，计算得出的每日金额是 %2$@。"}}}},
    "ask.answer.stressPattern.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Self-tagged pattern"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自选标签模式"}}}},
    "ask.answer.stress.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cycle has %d records you tagged as stressed, anxious, or stress relief."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期有 %d 笔记录被你标记为压力、焦虑或缓解压力。"}}}},
    "ask.answer.stress.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cycle has no records with those self-selected stress tags."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期没有使用这些自选压力标签的记录。"}}}},
    "ask.answer.impulsePattern.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Impulse tags"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冲动标签"}}}},
    "ask.answer.impulse.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cycle has %d records you tagged as impulse-related."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期有 %d 笔记录被你标记为与冲动有关。"}}}},
    "ask.answer.impulse.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This cycle has no records with a self-selected impulse tag."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本周期没有使用自选冲动标签的记录。"}}}},
    "ask.answer.categoryChange.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Category change"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分类变化"}}}},
    "ask.answer.categoryChange.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ increased the most: %@ this cycle compared with %@ in the previous month window."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 增加最多：本周期 %@，上一个月度窗口 %@。"}}}},
    "ask.answer.categoryChange.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"There is not enough comparable spending to identify an increased category."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前没有足够的可比消费记录来识别增加的分类。"}}}},
    "ask.answer.alternative.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A few alternatives"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"几个替代选择"}}}},
    "ask.answer.alternative.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You could save it to the wishlist, start a cooling-off period, or revisit it next cycle."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以先加入愿望清单、开始冷静期，或留到下个周期再看。"}}}},
    "ask.answer.wishlistStatus.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Wishlist status"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"愿望清单状态"}}}},
    "ask.answer.wishlistStatus.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%d items are cooling off or ready to review, and %d remain active."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%d 项正在冷静期或待回看，%d 项仍为活动状态。"}}}},
    "ask.answer.unknown.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"What I can answer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"我能回答的内容"}}}},
    "ask.answer.unknown.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask about remaining budget, affordability, category changes, self-selected stress or impulse tags, alternatives, or wishlist status."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你可以问剩余预算、是否负担得起、分类变化、自选的压力或冲动标签、替代选择或愿望清单状态。"}}}},
    "ask.answer.outOfScope.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Outside this tool"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"超出工具范围"}}}},
    "ask.answer.outOfScope.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget cannot provide investment, tax, loan, legal, diagnostic, or mental-health advice. I can help summarize your recorded budget facts."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MindBudget 不提供投资、税务、贷款、法律、诊断或心理健康建议。我可以帮你概括已记录的预算事实。"}}}},
    "ask.action.reviewRecentSpending": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review recent spending"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"回看近期消费"}}}},
    "ask.action.adjustBudget": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review budget settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查预算设置"}}}},
    "ask.action.addToWishlist": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add to wishlist"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"加入愿望清单"}}}},
    "ask.action.continuePurchase": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Continue the purchase"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"继续购买"}}}},
    "ask.action.startCoolingOff24h": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start a cooling-off period"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始冷静期"}}}},
    "ask.action.waitUntilNextCycle": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Revisit next cycle"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下个周期再看"}}}},
    "settings.ai.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask and Apple Intelligence"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Ask 与 Apple Intelligence"}}}},
    "settings.ask.enabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Show Ask MindBudget"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示“问 MindBudget”"}}}},
    "settings.ai.enhancement": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On-device wording enhancement"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机文字增强"}}}},
    "settings.ai.fallback": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ask and reminders remain fully usable with deterministic templates when enhancement is off or unavailable."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"增强关闭或不可用时，Ask 和提醒仍可通过确定性模板完整使用。"}}}},
    "settings.ai.debugFallbacks": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local fallback diagnostics (Debug)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地降级诊断（Debug）"}}}},
    "settings.ai.debug.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unavailable or disabled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不可用或已关闭"}}}},
    "settings.ai.debug.timeout": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Timed out"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请求超时"}}}},
    "settings.ai.debug.validationFailed": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Safety validation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安全校验失败"}}}},
    "settings.ai.debug.modelError": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Model or guardrail error"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"模型或护栏错误"}}}},
    "settings.ai.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enhancement runs with Apple's on-device model and receives only allow-listed aggregate facts. Questions, notes, and transaction rows are never sent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"增强使用 Apple 本机模型，仅接收明确允许的聚合事实。问题原文、备注和逐笔记录绝不会发送。"}}}},
    "settings.ai.status.available": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Intelligence enhancement is available"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Apple Intelligence 增强可用"}}}},
    "settings.ai.status.userDisabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enhancement is off"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"增强已关闭"}}}},
    "settings.ai.status.osTooOld": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Requires iOS 26 or later"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要 iOS 26 或更高版本"}}}},
    "settings.ai.status.deviceNotEligible": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Intelligence is not supported on this device"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备不支持 Apple Intelligence"}}}},
    "settings.ai.status.appleIntelligenceOff": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Apple Intelligence is off in System Settings"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"系统设置中的 Apple Intelligence 已关闭"}}}},
    "settings.ai.status.modelNotReady": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The on-device model is not ready yet"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机模型尚未就绪"}}}},
    "settings.ai.status.regionNotSupported": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enhancement is unavailable for the current region or language"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前地区或语言暂不支持增强"}}}},
    "settings.ai.status.buildUnsupported": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This build does not include on-device enhancement"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前版本未包含本机增强"}}}},
    "settings.ai.status.unknown": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enhancement is currently unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"增强当前不可用"}}}},
    "insights.summary.narrative.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Cycle snapshot"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"周期概览"}}}},
    "insights.summary.narrative.body": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Recorded spending uses %d%% of this cycle's budget. %@ is the leading category by recorded amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已记录消费占本周期预算的 %d%%。%@ 是已记录金额最高的分类。"}}}},
    "insights.summary.noCategory": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No category"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"暂无分类"}}}},
    "settings.integrations.section": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Siri and Search"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Siri 与搜索"}}}},
    "settings.integrations.siri": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use with Siri and Shortcuts"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"与 Siri 和快捷指令配合使用"}}}},
    "settings.integrations.siri.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"When you explicitly ask Siri to check budget impact, the authenticated result may speak the exact calculated flexible budget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当你主动请 Siri 查看预算影响时，通过认证的结果可能会播报精确的计算后灵活预算。"}}}},
    "settings.integrations.spotlight": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Show redacted items in Search"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在搜索中显示脱敏项目"}}}},
    "settings.integrations.merchants": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Include eligible merchant names"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"包含符合条件的商户名"}}}},
    "settings.integrations.merchants.detail": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A merchant appears only when at least one matching expense also allows merchant indexing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅当至少一笔匹配消费也允许商户索引时，该商户才会显示。"}}}},
    "settings.integrations.privacy": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Both controls are off by default. Search excludes exact amounts and notes. Merchant names remain excluded unless you enable both levels of consent."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"两项功能默认均关闭。搜索不包含精确金额和备注；只有你开启两层授权时才会包含商户名。"}}}},
    "settings.integrations.spotlight.error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search items could not be updated. Your local records are unchanged."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索项目未能更新，本地记录不受影响。"}}}},
    "settings.integrations.spotlight.unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Search indexing is unavailable on this device."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此设备当前无法使用搜索索引。"}}}},
    "intent.error.siriDisabled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Siri integration is off in MindBudget settings."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MindBudget 设置中的 Siri 集成已关闭。"}}}},
    "intent.error.invalidAmount": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a positive amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入正数金额。"}}}},
    "intent.error.amountOutOfRange": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter a smaller amount within MindBudget's supported range."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请输入 MindBudget 支持范围内的金额。"}}}},
    "intent.error.unsupportedPrecision": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This amount has more decimal places than the selected currency supports."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该金额的小数位超过了所选币种支持的位数。"}}}},
    "intent.error.unsupportedCurrency": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"That currency is not supported by MindBudget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MindBudget 暂不支持该币种。"}}}},
    "intent.error.temporary": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget cannot complete this right now. Try again in a moment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MindBudget 暂时无法完成此操作，请稍后再试。"}}}},
    "intent.error.invalidText": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add a name before continuing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先添加名称。"}}}},
    "intent.error.currencyNotConfigured": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Finish budget setup in MindBudget before using this action."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请先在 MindBudget 中完成预算设置。"}}}},
    "intent.error.currencyMismatch": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The requested currency does not match the accounting currency. Confirm the currency in MindBudget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请求的币种与记账币种不一致。请在 MindBudget 中确认币种。"}}}},
    "intent.error.budgetUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A current confirmed budget is needed for this calculation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这项计算需要当前已确认的预算。"}}}},
    "intent.error.itemUnavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"That item is no longer available in the wishlist."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该项目已不在愿望清单中。"}}}},
    "intent.error.data": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"MindBudget could not read the required local data."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MindBudget 未能读取所需的本地数据。"}}}},
    "intent.record.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Record Expense"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"记录消费"}}}},
    "intent.record.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Records one expense in the configured accounting currency."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用已设置的记账币种记录一笔消费。"}}}},
    "intent.record.summary ${amount} ${category}": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Record ${amount} in ${category}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 ${category} 记录 ${amount}"}}}},
    "intent.record.success": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The expense was recorded."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"消费已记录。"}}}},
    "intent.record.duplicate": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"That expense was already recorded in the last five seconds, so no duplicate was added."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该消费在过去 5 秒内已记录，因此未重复添加。"}}}},
    "intent.wishlist.add.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add Wishlist Item"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加愿望清单项"}}}},
    "intent.wishlist.add.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Adds an item with a default 24-hour cooling-off duration."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"添加一项，默认冷静期时长为 24 小时。"}}}},
    "intent.wishlist.add.summary ${itemName} ${category}": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Add ${itemName} in ${category}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将 ${itemName} 添加到 ${category}"}}}},
    "intent.wishlist.add.success": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The item was added with a 24-hour cooling-off default."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"项目已添加，默认冷静期为 24 小时。"}}}},
    "intent.impact.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check Budget Impact"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看预算影响"}}}},
    "intent.impact.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Calculates a candidate purchase without saving its name or amount."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计算候选购买对预算的影响，不保存其名称或金额。"}}}},
    "intent.impact.summary ${amount} ${category}": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check ${amount} in ${category}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看 ${category} 中的 ${amount}"}}}},
    "intent.impact.within": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"After this purchase, the calculated flexible budget would be %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这笔购买后，计算得出的灵活预算为 %@。"}}}},
    "intent.impact.over": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"This purchase would take the calculated budget below zero. The flexible budget after it would be %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这笔购买会使计算预算低于零，之后的灵活预算为 %@。"}}}},
    "intent.emotion.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review Emotional Spending"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"回顾情绪消费"}}}},
    "intent.emotion.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Counts recent records with user-selected emotion or reason tags."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"统计近期带有用户自选情绪或原因标签的记录。"}}}},
    "intent.emotion.result": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"There are %d matching records in the last 30 days."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"过去 30 天有 %d 笔匹配记录。"}}}},
    "intent.cooling.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start Cooling-Off Period"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"开始冷静期"}}}},
    "intent.cooling.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Starts a local cooling-off period for a wishlist item."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为愿望清单项开始本地冷静期。"}}}},
    "intent.cooling.summary ${item} ${durationHours}": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Start ${durationHours} hours for ${item}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为 ${item} 开始 ${durationHours} 小时冷静期"}}}},
    "intent.cooling.success.scheduled": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The cooling-off period was started and its review notification was scheduled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"冷静期已开始，回看通知已安排。"}}}},
    "intent.cooling.success.local": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The local cooling-off period was started. No notification was scheduled."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本地冷静期已开始，未安排通知。"}}}},
    "intent.alternative.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Suggest an Alternative"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"建议替代选择"}}}},
    "intent.alternative.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Offers neutral next steps without saving the candidate item name."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"提供中性的下一步选择，不保存候选商品名。"}}}},
    "intent.alternative.result": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"You could add it to the wishlist, start a 24-hour cooling-off period, or revisit it next cycle."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可以将它加入愿望清单、开始 24 小时冷静期，或下个周期再看。"}}}},
    "intent.pattern.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Find Recent Spending Pattern"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查找近期消费模式"}}}},
    "intent.pattern.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Returns the latest deterministic local insight from the last 30 days."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"返回过去 30 天最新的确定性本地洞察。"}}}},
    "intent.pattern.none": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"No recent stored pattern is available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前没有可用的近期已存储模式。"}}}},
    "intent.pattern.result": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The latest stored pattern is: %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最新已存储模式是：%@。"}}}},
    "intent.openWishlist.title": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Wishlist Item"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开愿望清单项"}}}},
    "intent.openWishlist.description": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Opens a selected wishlist item in MindBudget."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 MindBudget 中打开选定的愿望清单项。"}}}},
    "intent.openWishlist.summary ${item}": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open ${item}"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 ${item}"}}}},
