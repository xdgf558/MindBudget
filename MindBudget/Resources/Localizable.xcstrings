          "stringUnit": {
            "state": "translated",
            "value": "简体中文界面已统一使用产品名称“花有数”。"
          }
        }
      }
    },
    "settings.releaseNotes.included": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All three current skins are included, with improved previews and text readability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三套现有皮肤均可直接使用，并优化了预览与文字可读性。"
          }
        }
      }
    },
    "settings.releaseNotes.launchAnimation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added a brief brand animation for cold launches, with Reduce Motion support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增简短的冷启动品牌动画，并支持“减少动态效果”。"
          }
        }
      }
    },
    "settings.releaseNotes.skins": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added Aurora Glow, Warm Botanical, and Neon Pulse with complete background artwork."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增极光、暖植与霓虹三套皮肤，并补充完整背景图案。"
          }
        }
      }
