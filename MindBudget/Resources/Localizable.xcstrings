        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Confirmed Budgets"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存已确认的预算"
          }
        }
