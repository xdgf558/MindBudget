    "settings.ai.debug.validation.financialAdvice": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Financial-advice wording"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"财务建议措辞"}}}},
    "settings.ai.debug.validation.imperativeProhibition": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Purchase prohibition"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"禁止购买措辞"}}}},
